      "examGuide": {
        "style": "choice",
        "format": "Knowledge test on Lectures 1–7. Past tests used single-answer questions with four options.",
        "insights": [
          {
            "title": "Half the test is “X is:”.",
            "text": "For every acronym on the slides (YUV, DCT, DPCM, RLE, GOP, DVB-T, HEVC…) know what it stands for and what it does."
          },
          {
            "title": "Distractors are sibling terms",
            "text": "from the same lecture: YUV vs YIQ vs YCbCr, NTSC vs PAL vs SECAM, I vs P vs B frames, Huffman vs arithmetic vs LZW, GIF vs PNG vs TIFF."
          },
          {
            "title": "TRUE / NOT stems",
            "text": "change one property per option. Find the single wrong attribute and eliminate."
          },
          {
            "title": "Numbers come from tables and boxed formulas:",
            "text": "line counts, frame rates, sampling ratios, block sizes, bit depths, coefficients."
          },
          {
            "title": "Attribution trivia",
            "text": "(who invented it, which company, which year) was 5 % last time. Lecture 3's history slides and Lecture 5's modern-format slides are the likely sources."
          },
          {
            "title": "Learn the concept, not the sentence.",
            "text": "The same fact returns reversed, negated or as a number."
          }
        ],
        "pastShapes": [
          [
            "Definition: “X is:”",
            48
          ],
          [
            "Which / identify",
            25
          ],
          [
            "Which statement is true",
            8
          ],
          [
            "Attribution: who made it",
            5
          ],
          [
            "Acronym: “X stands for”",
