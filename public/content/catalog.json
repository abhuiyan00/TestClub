      "examGuide": {
        "style": "open",
        "format": "Written test with open questions. Practice here works the same way: write or say your answer, reveal the model answer, then grade yourself honestly.",
        "insights": [
          {
            "title": "Definitions must be exact.",
            "text": "Superkey, candidate key, closure, lossless join, dependency preservation, 2NF, 3NF, BCNF: say what each one requires, not just its name."
          },
          {
            "title": "Expect to compute, not only to recall.",
            "text": "Closures of attribute sets, candidate keys, minimal covers and decompositions come up as small worked tasks. Show the steps."
          },
          {
            "title": "Algebra questions read both ways.",
            "text": "Translate a relational algebra expression into words, and a question in words into algebra."
          },
          {
            "title": "Labs are examinable too.",
            "text": "The test covers the laboratories as well as the lectures, so keep the SQL from the labs in mind."
          }
        ]
      }
